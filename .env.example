# Copy to .env and fill in. docker-compose reads this file automatically.

# Database password (used by both the db container and the app's DATABASE_URL)
POSTGRES_PASSWORD=change-this-db-password

# Secret used to sign session cookies — generate with: openssl rand -base64 32
SESSION_SECRET=change-this-long-random-secret

# Optional: webhook for new-lead / high-priority alerts (Slack, Discord, Telegram, or custom)
# Slack/Discord incoming webhook URL works out of the box.
WEBHOOK_URL=

# Priority (1-10) at or above which a lead triggers a HIGH-PRIORITY alert
HIGH_PRIORITY_THRESHOLD=8

# ---- Telegram alerts (instant new-lead pings to your phone) ----
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here.
# 2. Message your new bot once, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  and copy chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email (real notifications). Leave blank to disable; the app still works. ----
# For Gmail: host smtp.gmail.com, port 465, user = your gmail, pass = an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=              # usually the same as SMTP_USER
MAIL_TO=               # where new-enquiry notifications are sent (the shop owner inbox)
AUTO_REPLY=true        # true = automatically email the customer the drafted reply

# ---- Only needed when running WITHOUT docker (local node) ----
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/leadflow
# PORT=3000
